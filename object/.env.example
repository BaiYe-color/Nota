# Copy to object/.env only on a new installation; keep existing credentials.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GPT_MODEL=gpt-5.4
VISION_MODEL=gpt-5.4
CARDS_MODEL=gpt-5.4
WRITER_MODEL=gpt-5.4
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
OUTLINE_MODEL=deepseek-chat
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
PARAFORMER_MODEL=paraformer-v2
NOTA_WORKERS=2
NOTA_MODEL_CONCURRENCY=4
NOTA_MAX_UPLOAD_MB=200
NOTA_LLM_TIMEOUT=120
NOTA_PORT=7860

# Empty value disables automatic fallback for transient text-provider failures.
NOTA_TEXT_FALLBACK_MODEL=deepseek-chat

NOTA_VISION_FALLBACK_MODEL=qwen-vl-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
