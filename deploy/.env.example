# Public domain. Point its A/AAAA record to this server before starting Caddy.
NOTA_DOMAIN=nota.example.com

# Required: protect this single-user service before exposing it to the Internet.
NOTA_BASIC_AUTH_USER=nota
# Generate with: docker compose run --rm caddy caddy hash-password --plaintext 'choose-a-long-password'
NOTA_BASIC_AUTH_HASH=

# Replace nota.example.com here when NOTA_DOMAIN changes.
# Restrict Host headers to the public domain and local reverse-proxy addresses.
NOTA_ALLOWED_HOSTS=nota.example.com,localhost,127.0.0.1,app

# Model and ASR credentials. Do not commit this file after filling it in.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GPT_MODEL=
VISION_MODEL=
CARDS_MODEL=
WRITER_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
OUTLINE_MODEL=deepseek-chat
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
PARAFORMER_MODEL=paraformer-v2

# Conservative settings for a 4-core / 8-GB personal server.
NOTA_WORKERS=2
NOTA_MODEL_CONCURRENCY=2
NOTA_MAX_UPLOAD_MB=100
NOTA_LLM_TIMEOUT=120

# The maintenance container cleans old cache/exports daily. Uploads, notes and
# SQLite data are never auto-deleted. Set quota to 0 to disable the size cap.
NOTA_MAINTENANCE_INTERVAL_SECONDS=86400
NOTA_CACHE_RETENTION_DAYS=14
NOTA_ARTIFACT_RETENTION_DAYS=30
NOTA_CACHE_ARTIFACT_MAX_MB=4096
